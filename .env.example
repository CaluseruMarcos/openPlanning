# PocketBase API used by the Expo app.
#
# Leave this unset during development: the app auto-detects the Expo dev
# server's LAN host (so physical phones and the Android emulator work).
# Set it explicitly for release builds or unusual networks.
#
# Web / iOS simulator: http://127.0.0.1:8090
# Android emulator:    http://10.0.2.2:8090
# Physical device:     http://<your-computer-lan-ip>:8090
#
# EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
