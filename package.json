{
  "name": "open-services-rebuild",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "app": "node scripts/start-app.mjs",
    "app:native": "node scripts/start-app.mjs --native",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "worker:dev": "wrangler dev -c worker/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply DB -c worker/wrangler.toml --local",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:seed": "node worker/seed.mjs",
    "worker:invite": "node worker/invite.mjs",
    "backend:setup": "cd backend && ./setup.sh",
    "backend": "cd backend && ./start.sh",
    "seed": "node backend/seed.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "expo": "~57.0.30",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "wrangler": "^4.151.3"
  }
}
